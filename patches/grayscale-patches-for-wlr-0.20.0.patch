diff --git a/render/gles2/shaders/quad.frag b/render/gles2/shaders/quad.frag
index a83af080..f421bad3 100644
--- a/render/gles2/shaders/quad.frag
+++ b/render/gles2/shaders/quad.frag
@@ -15,8 +15,44 @@ vec4 saturate_1(vec4 sample,float is_grayscale)  {
   return sample;
 }
 
+uniform float hue_adjust;
+vec4 yiqShift4(vec4 color, float hueAdjust)
+{
+
+  if (hueAdjust == 0.0) {
+    return color;
+  }
+
+    const vec4  kRGBToYPrime = vec4 (0.299, 0.587, 0.114, 0.0);
+    const vec4  kRGBToI     = vec4 (0.596, -0.275, -0.321, 0.0);
+    const vec4  kRGBToQ     = vec4 (0.212, -0.523, 0.311, 0.0);
+
+    const vec4  kYIQToR   = vec4 (1.0, 0.956, 0.621, 0.0);
+    const vec4  kYIQToG   = vec4 (1.0, -0.272, -0.647, 0.0);
+    const vec4  kYIQToB   = vec4 (1.0, -1.107, 1.704, 0.0);
+
+    float   YPrime  = dot (color, kRGBToYPrime);
+    float   I      = dot (color, kRGBToI);
+    float   Q      = dot (color, kRGBToQ);
+
+    float   hue     = atan (Q, I);
+    float   chroma  = sqrt (I * I + Q * Q);
+
+    hue += hueAdjust;
+
+    Q = chroma * sin (hue);
+    I = chroma * cos (hue);
+
+    vec4    yIQ   = vec4 (YPrime, I, Q, 0.0);
+    color.r = dot (yIQ, kYIQToR);
+    color.g = dot (yIQ, kYIQToG);
+    color.b = dot (yIQ, kYIQToB);
+
+ return color;
+}
+
 vec4 transform(vec4 color) {
-  return saturate_1(color, is_grayscale);
+  return yiqShift4( saturate_1(color, is_grayscale), hue_adjust );
 }
 
 void main() {
