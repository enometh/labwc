 create mode 100644 render/gles2/shaders/templ/quad.frag
 create mode 100644 render/gles2/shaders/templ/template.frag
 create mode 100644 render/gles2/shaders/templ/tex_external.frag
 create mode 100644 render/gles2/shaders/templ/tex_rgba.frag
 create mode 100644 render/gles2/shaders/templ/tex_rgbx.frag

diff --git a/render/gles2/shaders/quad.frag b/render/gles2/shaders/quad.frag
index d676adde..a83af080 100644
--- a/render/gles2/shaders/quad.frag
+++ b/render/gles2/shaders/quad.frag
@@ -9,10 +9,16 @@ varying vec2 v_texcoord;
 uniform vec4 color;
 
 uniform float is_grayscale;
+vec4 saturate_1(vec4 sample,float is_grayscale)  {
+  vec3 grayscale = vec3(dot(sample.rgb, vec3(0.299, 0.587, 0.114)));
+  sample.rgb = mix(sample.rgb, grayscale, is_grayscale);
+  return sample;
+}
+
+vec4 transform(vec4 color) {
+  return saturate_1(color, is_grayscale);
+}
 
 void main() {
-	vec4 sample = color;
-	vec3 grayscale = vec3(dot(sample.rgb, vec3(0.299, 0.587, 0.114)));
-	sample.rgb = mix(sample.rgb, grayscale, is_grayscale);
-	gl_FragColor = sample;
+	gl_FragColor = transform(color);
 }
diff --git a/render/gles2/shaders/templ/1.sh b/render/gles2/shaders/templ/1.sh
